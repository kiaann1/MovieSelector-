# Neon Postgres connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign session cookies + hash PINs (use a long random string in production)
AUTH_SECRET=change-me-to-a-long-random-string

# The Movie Database — use either access token (preferred) or API key
# https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# OMDb API key for IMDb + Rotten Tomatoes scores (https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=
